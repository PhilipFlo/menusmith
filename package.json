{
  "name": "menusmith",
  "version": "0.1.0",
  "description": "Agents that write the menu scraper once, test it, and heal it \u2014 so a restaurant price index runs forever. Built on NVIDIA Nemotron via Nebius Token Factory.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "tsx src/server/index.ts",
    "forge": "tsx src/cli.ts forge",
    "fleet": "tsx src/cli.ts fleet",
    "bench": "tsx bench/run.ts",
    "demo": "MENUSMITH_LLM=replay MENUSMITH_CASSETTES=cassettes-demo MENUSMITH_LIBRARY=.cache/demo-library tsx src/cli.ts demo",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "cheerio": "^1.2.0",
    "dotenv": "^16.6.1",
    "hono": "^4.13.13",
    "openai": "^4.104.0",
    "playwright": "^1.64.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
