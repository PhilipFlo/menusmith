# Image for small / free hosts (e.g. Render free: 512 MB RAM, 0.1 CPU).
# Includes Chromium's small headless shell in low-memory mode (one render at a time, closed
# after each render): JavaScript-built menus work here too — measured at 512 MB / 0.1 CPU,
# peak ~400 MB, 2–4 minutes per JavaScript site. The full image (Dockerfile) is the faster
# option for bigger hosts.
FROM node:22-slim

WORKDIR /app
ENV NODE_ENV=production \
    PORT=8790 \
    MENUSMITH_LLM=live \
    MENUSMITH_STORE_SYNC=1 \
    MENUSMITH_RENDER_LOWMEM=1 \
    MENUSMITH_MAX_CONCURRENT=1 \
    MENUSMITH_FLEET_CONCURRENCY=1 \
    MENUSMITH_SANDBOX_TIMEOUT_MS=60000 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

COPY package.json package-lock.json ./
RUN npm ci --include=dev --no-audit --no-fund \
 && npx playwright install --with-deps --only-shell chromium \
 && rm -rf /var/lib/apt/lists/*

COPY . .
RUN npm run build && rm -rf .env .cache bench/private

EXPOSE 8790
CMD ["npx", "tsx", "src/server/index.ts"]
