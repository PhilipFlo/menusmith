# Nebius Token Factory — https://tokenfactory.nebius.com (Builder Program gives free credits)
NEBIUS_API_KEY=
# Tavily — https://app.tavily.com (1,000 free credits/month)
TAVILY_API_KEY=

# Optional overrides. Defaults are the NVIDIA Nemotron models served on Token Factory.
# MENUSMITH_MODEL_TRIAGE=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# MENUSMITH_MODEL_ORACLE=nvidia/nemotron-3-super-120b-a12b
# MENUSMITH_MODEL_FORGE=nvidia/Nemotron-3-Ultra-550b-a55b

# LLM mode: "live" calls Token Factory; "replay" serves recorded responses from
# cassettes/ (no key needed — used by tests and the offline demo); "record" calls
# live and saves cassettes.
MENUSMITH_LLM=live
PORT=8790
